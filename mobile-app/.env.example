# Copy to .env and load before `expo start` (or set as EAS secrets).
# The Supabase URL + anon key are PUBLIC values (safe in a client build).

# Same values as the web app's NEXT_PUBLIC_SUPABASE_URL / _ANON_KEY
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Where the Next.js /api/* routes are reachable from the device.
# Prod EC2 backend:
EXPO_PUBLIC_API_BASE_URL=https://api.samedaysolution.in
# Local dev against your machine (use LAN IP, not localhost, from a real device):
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.50:3000

# EAS project id (after `eas init`) — also required for push notifications
EAS_PROJECT_ID=

# Optional: JSON manifest for the force-update gate. Leave empty to disable.
# Example JSON: {"minVersion":"1.0.0","latestVersion":"1.1.0","android":"https://play.google.com/...","ios":"https://apps.apple.com/...","message":"Please update."}
EXPO_PUBLIC_UPDATE_MANIFEST_URL=
